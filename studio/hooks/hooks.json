{
  "hooks": {
    "PreToolUse": [{"matcher": "Agent|Task", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/activity.sh\"", "timeout": 5}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/activity.sh\"", "timeout": 5}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/activity.sh\"", "timeout": 5}]}],
    "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/activity.sh\"", "timeout": 5}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/activity.sh\"", "timeout": 5}]}]
  }
}
