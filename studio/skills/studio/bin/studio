#!/usr/bin/env bash
# The one entry point to the studio kit. It runs every command inside the pinned environment, so an
# agent never manages shells: inside `nix develop .#studio` (STUDIO_ENV is set) it runs directly;
# otherwise, when nix exists, it loads the flake's environment first. `nix print-dev-env` is cached
# per flake.lock, because entering the shell on every call would add seconds to each still.
# STUDIO_NO_NIX=1 skips nix and uses whatever is on PATH (`studio doctor` says what is missing).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
preflight=0
[ "${1:-}" != preflight ] || preflight=1

# A cloud session opened outside papershop (one that clones several repos starts in their parent) never
# runs papershop's SessionStart hook, so the first call there bootstraps the checkout; bootstrap's stamp
# marks it done, by the hook or by this.
papershop="$(cd "$here/../../.." 2>/dev/null && pwd || true)"
if [ "${CLAUDE_CODE_REMOTE:-}" = true ] && [ "$preflight" = 0 ] && [ "$papershop/studio/skills/studio" -ef "$here" ] &&
   [ -x "$papershop/script/bootstrap" ] && [ ! -e "$papershop/.cache/bootstrapped" ]; then
  log="${TMPDIR:-/tmp}/papershop-bootstrap.log"
  echo "studio: first call in this cloud session; running papershop's script/bootstrap (about a minute, log in $log)" >&2
  "$papershop/script/bootstrap" >"$log" 2>&1 || echo "studio: bootstrap failed; see $log" >&2
fi

if [ -z "${STUDIO_ENV:-}" ] && [ -z "${STUDIO_NO_NIX:-}" ] && command -v nix >/dev/null; then
  # A workspace copy carries its own flake; otherwise it is the plugin's, two levels up.
  if [ -f "$here/flake.nix" ]; then flake="$here"; else flake="$(cd "$here/../.." && pwd)"; fi
  lock_hash="$( (cat "$flake/flake.lock" "$flake/flake.nix") | shasum | cut -c1-12)"
  env_file="$here/.cache/devenv-$lock_hash.sh"
  if [ ! -s "$env_file" ]; then
    if [ "$preflight" = 1 ]; then
      echo "setup required: Nix is installed, but this kit's pinned environment has not been prepared."
      echo "Read references/kit.md; confirm the environment, package, browser and model downloads before running doctor --fetch."
      exit 1
    fi
    mkdir -p "$here/.cache"
    echo "studio: preparing the pinned environment (nix develop .#studio), once per flake.lock; a minute or two on a new machine" >&2
    # Only the variables the kit needs: the full `print-dev-env` script uses bash 4+ syntax, and
    # macOS runs this wrapper with bash 3.2. Nix's download lines go to a log, shown only on failure.
    if ! nix --extra-experimental-features 'nix-command flakes' develop "$flake#studio" -c bash -c \
      'for v in PATH STUDIO_ENV SSL_CERT_FILE NIX_SSL_CERT_FILE; do
         if [ -n "${!v:-}" ]; then printf "export %s=%q\n" "$v" "${!v}"; fi; done' > "$env_file.tmp" 2>"$here/.cache/devenv.log"; then
      cat "$here/.cache/devenv.log" >&2; exit 1
    fi
    mv "$env_file.tmp" "$env_file"
  fi
  # shellcheck disable=SC1090
  source "$env_file"
fi

# Unlike every production command, preflight must work before uv/Python exists, and must not sync
# packages, create caches, enter Nix or download a browser/model. Inspect this kit, never an old pin.
if [ "$preflight" = 1 ]; then
  shift
  missing=0
  for tool in uv node npm ffmpeg ffprobe sox; do
    if ! command -v "$tool" >/dev/null; then echo "missing: $tool"; missing=1; fi
  done
  if [ ! -x "$here/kit/.venv/bin/python" ]; then echo "missing: kit Python environment"; missing=1; fi
  if [ "$missing" = 1 ]; then
    echo "setup required: read references/kit.md and confirm the missing installs before doctor --fetch."
    echo "Use Nix on a supported platform, or STUDIO_NO_NIX=1 with Python 3.12, uv, Node 22+, ffmpeg 6+ and sox."
    exit 1
  fi
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$here/kit/src${PYTHONPATH:+:$PYTHONPATH}" \
    exec "$here/kit/.venv/bin/python" -m studio_kit.cli preflight "$@"
fi

if ! command -v uv >/dev/null; then
  echo "studio: uv is missing. Run '$here/bin/studio preflight' and follow references/kit.md." >&2
  exit 1
fi

# Sync base dependencies without removing extras or separately installed model wheels, and restore the
# extras doctor --fetch recorded in kit/.extras, which a rebuilt .venv (a new Python) would otherwise lose.
extras=()
if [ -f "$here/kit/.extras" ]; then
  while read -r extra; do [ -z "$extra" ] || extras+=(--extra "$extra"); done < "$here/kit/.extras"
fi
uv sync --quiet --frozen --inexact ${extras[@]+"${extras[@]}"} --project "$here/kit"
exec uv run --quiet --no-sync --project "$here/kit" studio "$@"
