#!/usr/bin/env bash
# The one entry point to the studio kit. It runs every command inside the pinned environment, so an
# agent never manages shells: inside `nix develop .#studio` (STUDIO_ENV is set) it runs directly;
# otherwise, when nix exists, it loads the flake's environment first. `nix print-dev-env` is cached
# per flake.lock, because entering the shell on every call would add seconds to each still.
# STUDIO_NO_NIX=1 skips nix and uses whatever is on PATH (`studio doctor` says what is missing).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# A video that pinned its kit (`studio init`) runs that copy, so a plugin update can't change how it renders.
# An explicit update must run the installed kit, not route back into the old pinned copy.
updating=0
if [ "${1:-}" = init ]; then
  for arg in "$@"; do [ "$arg" != --update ] || updating=1; done
fi
if [ -z "${STUDIO_PINNED:-}" ] && [ "$updating" = 0 ] && [ "${1:-}" != new ] && [ "${1:-}" != variant ]; then
  for arg in "$@"; do
    if [ -x "$arg/.studio/bin/studio" ] && [ "$(cd "$arg/.studio" && pwd)" != "$here" ]; then
      STUDIO_PINNED=1 exec "$arg/.studio/bin/studio" "$@"
    fi
  done
fi

if [ -z "${STUDIO_ENV:-}" ] && [ -z "${STUDIO_NO_NIX:-}" ] && command -v nix >/dev/null; then
  # A workspace copy carries its own flake; otherwise it is the plugin's, two levels up.
  if [ -f "$here/flake.nix" ]; then flake="$here"; else flake="$(cd "$here/../.." && pwd)"; fi
  lock_hash="$( (cat "$flake/flake.lock" "$flake/flake.nix") | shasum | cut -c1-12)"
  env_file="$here/.cache/devenv-$lock_hash.sh"
  if [ ! -s "$env_file" ]; then
    mkdir -p "$here/.cache"
    # Only the variables the kit needs: the full `print-dev-env` script uses bash 4+ syntax, and
    # macOS runs this wrapper with bash 3.2.
    nix develop "$flake#studio" -c bash -c \
      'for v in PATH STUDIO_ENV SSL_CERT_FILE NIX_SSL_CERT_FILE; do
         if [ -n "${!v:-}" ]; then printf "export %s=%q\n" "$v" "${!v}"; fi; done' > "$env_file.tmp"
    mv "$env_file.tmp" "$env_file"
  fi
  # shellcheck disable=SC1090
  source "$env_file"
fi

# Sync base dependencies without removing extras or separately installed model wheels.
uv sync --quiet --frozen --inexact --project "$here/kit"
exec uv run --quiet --no-sync --project "$here/kit" studio "$@"
