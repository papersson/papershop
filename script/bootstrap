#!/usr/bin/env bash
# Make a fresh clone ready for papershop work. Idempotent and quick when nothing changed, so the cloud
# SessionStart hook can run it on every session.
#
# With Nix installed (the Mac, z840), the flake supplies the system tools: bin/studio and script/test
# enter it, and this script only prepares the Python environments. Without Nix (Claude's cloud image),
# it installs missing system tools with apt-get when it runs as root, which the cloud does.
#
#   script/bootstrap            # uv, ffmpeg, sox, sops and age, the studio kit (audio extra + dev), the worklog CLI
#   script/bootstrap --kokoro   # also local narration: torch and Kokoro, several GB, weights from huggingface.co
#   script/bootstrap --studio   # also studio's browser, live engine and sound kit (`studio doctor --fetch`)
#   script/bootstrap --observability  # also the servers the wide-events film runs (ClickHouse, Postgres,
#                                     # Prometheus, Loki, the OpenTelemetry Collector); needs Nix, about 1.5 GB
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
kit="$root/studio/skills/studio/kit"
cd "$root"   # uv reads uv.toml from here
kokoro=0 studio=0 observability=0
for arg in "$@"; do
  case "$arg" in
    --kokoro) kokoro=1 ;;
    --studio) studio=1 ;;
    --observability) observability=1 ;;
    *) echo "usage: script/bootstrap [--kokoro] [--studio] [--observability]" >&2; exit 2 ;;
  esac
done
say() { echo "bootstrap: $*"; }
tools="$root/.cache/tools"
export PATH="$tools/bin:$HOME/.local/bin:$PATH"

# The uv that uv.toml names goes in .cache/tools, from PyPI rather than astral.sh, which the cloud's
# default network does not allow. Any uv already here can fetch it (ignoring uv.toml, which an older uv
# would refuse); otherwise pip, which Debian's python3 lacks until apt installs it.
pin="$(sed -n 's/^required-version = ">=\(.*\)"$/\1/p' "$root/uv.toml")"
if [ "$(uv --version 2>/dev/null | cut -d' ' -f2)" != "$pin" ]; then
  say "installing uv $pin into .cache/tools"
  if command -v uv >/dev/null; then
    uv pip install --quiet --no-config --system --target "$tools" "uv==$pin"
  else
    if ! python3 -m pip --version >/dev/null 2>&1 && [ "$(id -u)" = 0 ] && command -v apt-get >/dev/null; then
      apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends python3-pip >/dev/null
    fi
    python3 -m pip install --quiet --target "$tools" "uv==$pin" 2>/dev/null ||
      python3 -m pip install --quiet --break-system-packages --target "$tools" "uv==$pin"
  fi
  hash -r   # bash remembers where it found the old uv
fi

if ! command -v nix >/dev/null; then
  missing=()
  for tool in ffmpeg sox; do command -v "$tool" >/dev/null || missing+=("$tool"); done
  if [ ${#missing[@]} -gt 0 ]; then
    if [ "$(id -u)" = 0 ] && command -v apt-get >/dev/null; then
      say "installing ${missing[*]} with apt-get"
      apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}" >/dev/null
    else
      say "missing ${missing[*]}: install them, or install Nix and use the flake" >&2
    fi
  fi
  node_major="$(node --version 2>/dev/null | sed 's/^v\([0-9]*\).*/\1/')"
  [ "${node_major:-0}" -ge 22 ] || say "studio needs Node 22 or newer (found ${node_major:-none})" >&2
fi

# sops and age decrypt the committed secrets (script/secrets). With Nix, the flake's, linked into
# .cache/tools/secrets; without, sops's release binary at the flake's version, checked against its
# published checksum, and apt's age.
sops_pin=3.13.1
if command -v nix >/dev/null; then
  nix --extra-experimental-features 'nix-command flakes' build "$root#secrets" --out-link "$tools/secrets"
elif [ "$("$tools/secrets/bin/sops" --version 2>/dev/null | head -1 | cut -d' ' -f2)" != "$sops_pin" ]; then
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) asset=linux.amd64 ;; Linux-aarch64) asset=linux.arm64 ;; Darwin-arm64) asset=darwin.arm64 ;;
    *) asset="" ;;
  esac
  if [ -n "$asset" ]; then
    say "installing sops $sops_pin into .cache/tools/secrets"
    url="https://github.com/getsops/sops/releases/download/v$sops_pin"
    mkdir -p "$tools/secrets/bin"
    curl -sSfL "$url/sops-v$sops_pin.$asset" -o "$tools/secrets/bin/sops.tmp"
    want="$(curl -sSfL "$url/sops-v$sops_pin.checksums.txt" | awk -v f="sops-v$sops_pin.$asset" '$2 == f { print $1 }')"
    if [ "$(sha256sum "$tools/secrets/bin/sops.tmp" | cut -d' ' -f1)" = "$want" ]; then
      chmod +x "$tools/secrets/bin/sops.tmp" && mv "$tools/secrets/bin/sops.tmp" "$tools/secrets/bin/sops"
    else
      rm -f "$tools/secrets/bin/sops.tmp"; say "sops download failed its checksum; not installed" >&2
    fi
  fi
  if ! command -v age-keygen >/dev/null && [ "$(id -u)" = 0 ] && command -v apt-get >/dev/null; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends age >/dev/null
  fi
fi

# --inexact keeps extras installed earlier (Kokoro, align) instead of removing everything not asked for.
# align is the voice check's recogniser, which every narration uses; kit/.extras lets bin/studio
# restore these when uv rebuilds the environment.
extras=(--extra audio --extra align)
[ "$kokoro" = 0 ] || extras+=(--extra kokoro)
uv sync --quiet --frozen --inexact "${extras[@]}" --project "$kit"
printf '%s\n' audio align $([ "$kokoro" = 0 ] || echo kokoro) $(cat "$kit/.extras" 2>/dev/null) | awk 'NF && !seen[$0]++' > "$kit/.extras.tmp" && mv "$kit/.extras.tmp" "$kit/.extras"

# worklog's plugin hook drops this shim; outside the plugin (a cloud session) nothing else would.
if ! command -v worklog >/dev/null; then
  mkdir -p "$HOME/.local/bin"
  printf '#!/usr/bin/env bash\nexec uv run --script "%s" "$@"\n' "$root/worklog/scripts/worklog.py" > "$HOME/.local/bin/worklog"
  chmod +x "$HOME/.local/bin/worklog"
  say "installed the worklog CLI in ~/.local/bin"
fi
# Fetch its duckdb now, so the CLI and its tests also work without a network later.
uv run --quiet --with "$(sed -n 's/.*"\(duckdb[^"]*\)".*/\1/p' "$root/worklog/scripts/worklog.py" | head -1)" python -c 'import duckdb'

if [ "$studio" = 1 ]; then
  studio=("$root/studio/skills/studio/bin/studio")
  command -v nix >/dev/null || studio=(env STUDIO_NO_NIX=1 "${studio[@]}")
  # Fetch first (its closing check may fail on a bare Linux), then give the headless shell the system
  # libraries it links (NSS, ATK, X11), which Playwright knows and installs with apt as root.
  "${studio[@]}" doctor --fetch || true
  if [ "$(uname -s)" = Linux ] && [ "$(id -u)" = 0 ] && command -v apt-get >/dev/null; then
    (cd "$root/studio/skills/studio/engines/live" && node node_modules/playwright-core/cli.js install-deps chromium-headless-shell >/dev/null)
  fi
  "${studio[@]}" doctor
fi
if [ "$observability" = 1 ]; then
  command -v nix >/dev/null || { say "--observability needs Nix (https://nixos.org/download)"; exit 1; }
  # A link in .cache/tools keeps the servers from being garbage-collected and lets the film find them.
  nix --extra-experimental-features 'nix-command flakes' build --out-link "$tools/observability" "$root#observability"
  say "observability servers in .cache/tools/observability"
fi
touch "$root/.cache/bootstrapped"   # bin/studio bootstraps a cloud session whose hook did not run
say "done"
