#!/usr/bin/env bash
# Prove a fresh clone works on a machine that has nothing of mine on it: bundle this checkout's HEAD,
# clone it inside a throwaway container with no home directory, Nix or Homebrew, then run
# script/bootstrap and script/test. Anything the repo relies on but does not declare fails here.
#
# The image stands in for Claude's cloud image: Debian with Node 22, Python 3, git and curl. It does
# not reproduce the cloud's network allowlist; script/doctor reports reachability there.
#
#   script/clean-check                 # native architecture (fast)
#   script/clean-check --amd64         # x86_64, like the cloud (emulated on Apple silicon, slower)
#   script/clean-check -- <cmd...>     # run <cmd> in the fresh clone instead of bootstrap + test
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image="node:22-bookworm"
platform=()
if [ "${1:-}" = --amd64 ]; then platform=(--platform linux/amd64); shift; fi
if [ "${1:-}" = -- ]; then shift; cmd="$*"; else cmd="script/bootstrap && script/test"; fi

command -v docker >/dev/null || { echo "clean-check: docker is not installed" >&2; exit 1; }
docker info >/dev/null 2>&1 || { echo "clean-check: the docker daemon is not running" >&2; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
git -C "$root" bundle create -q "$work/repo.bundle" HEAD
echo "clean-check: $(git -C "$root" rev-parse --short HEAD) in a fresh ${platform[1]:-native} $image"

# HOME is an empty directory, so nothing from ~/.claude, dotfiles or caches can leak in.
docker run --rm ${platform[@]+"${platform[@]}"} -v "$work/repo.bundle:/repo.bundle:ro" -e HOME=/home/fresh "$image" \
  bash -c "set -euo pipefail; mkdir -p /home/fresh; export PATH=\$HOME/.local/bin:\$PATH; git -c advice.detachedHead=false clone -q /repo.bundle /work/papershop
           cd /work/papershop; $cmd"
