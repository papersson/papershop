#!/usr/bin/env bash
# Prove a fresh clone works on a machine that has nothing of mine on it: bundle this checkout's HEAD,
# clone it inside a throwaway container with no home directory, Nix or Homebrew, then run
# script/bootstrap and script/test. Anything the repo relies on but does not declare fails here.
#
# The image stands in for Claude's cloud image: Debian with Node 22, Python 3, git and curl. The cloud
# image also has Nix (seen in a session, not documented), which --nix adds: Nix on a Linux that is not
# NixOS is where its Python can't load the system's shared libraries. --nix also makes uv prefer the
# Pythons on PATH, as it does on the cloud's Ubuntu, whose system Python is the kit's 3.12; Debian's is
# 3.11, so uv would otherwise download its own and never meet Nix's. It does not reproduce the cloud's
# network allowlist; script/doctor reports reachability there.
#
#   script/clean-check                 # this machine's architecture (fast)
#   script/clean-check --amd64         # x86_64, like the cloud (emulated on Apple silicon, slower)
#   script/clean-check --nix           # with Nix installed first, like the cloud
#   script/clean-check -- <cmd...>     # run <cmd> in the fresh clone instead of bootstrap + test
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image="node:22-bookworm"
platform=() nix=""
while [ $# -gt 0 ]; do
  case "$1" in
    --amd64) platform=(--platform linux/amd64); shift ;;
    --nix) nix="curl -sSfL https://install.determinate.systems/nix | sh -s -- install linux --init none --no-confirm >/tmp/nix.log 2>&1 || { tail /tmp/nix.log; exit 1; }
           export PATH=/nix/var/nix/profiles/default/bin:\$PATH UV_PYTHON_PREFERENCE=system; echo \"clean-check: \$(nix --version)\""; shift ;;
    --) shift; break ;;
    *) echo "usage: script/clean-check [--amd64] [--nix] [-- <cmd...>]" >&2; exit 2 ;;
  esac
done
if [ $# -gt 0 ]; then cmd="$*"; else cmd="script/bootstrap && script/test"; fi
# Always name the platform: the image tag holds whichever architecture was pulled last.
if [ ${#platform[@]} -eq 0 ]; then
  case "$(uname -m)" in arm64|aarch64) platform=(--platform linux/arm64) ;; *) platform=(--platform linux/amd64) ;; esac
fi

command -v docker >/dev/null || { echo "clean-check: docker is not installed" >&2; exit 1; }
docker info >/dev/null 2>&1 || { echo "clean-check: the docker daemon is not running" >&2; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
git -C "$root" bundle create -q "$work/repo.bundle" HEAD
echo "clean-check: $(git -C "$root" rev-parse --short HEAD) in a fresh ${platform[1]} $image${nix:+ with Nix}"

# HOME is an empty directory, so nothing from ~/.claude, dotfiles or caches can leak in.
docker run --rm ${platform[@]+"${platform[@]}"} -v "$work/repo.bundle:/repo.bundle:ro" -e HOME=/home/fresh "$image" \
  bash -c "set -euo pipefail; mkdir -p /home/fresh; export PATH=\$HOME/.local/bin:\$PATH; git -c advice.detachedHead=false clone -q /repo.bundle /work/papershop
           $nix
           cd /work/papershop; $cmd"
