#!/usr/bin/env bash
# The SessionStart hook. A cloud session starts from a bare clone, so it bootstraps first; a local
# session already has its environment and only reports readiness.
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ "${CLAUDE_CODE_REMOTE:-}" = true ]; then
  log="${TMPDIR:-/tmp}/papershop-bootstrap.log"
  "$root/script/bootstrap" >"$log" 2>&1 || echo "bootstrap failed; see $log" >&2
fi
# The session's commands get the repo's pinned uv (.cache/tools) and bootstrap's worklog shim.
[ -z "${CLAUDE_ENV_FILE:-}" ] || echo "export PATH=\"$root/.cache/tools/bin:\$HOME/.local/bin:\$PATH\"" >>"$CLAUDE_ENV_FILE"
exec "$root/script/doctor" --hook
