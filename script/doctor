#!/usr/bin/env bash
# Say in one line whether this checkout is ready for papershop work, and for anything missing, what it
# affects and the command that fixes it. Fast (no network locally, no Nix shell, no imports), because
# the SessionStart hook runs it on every session. `studio/skills/studio/bin/studio doctor` goes deeper.
#
#   script/doctor          # human-readable
#   script/doctor --hook   # SessionStart JSON: the line for the user, the details for Claude
set -uo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$root/.cache/tools/bin:$root/.cache/tools/secrets/bin:$HOME/.local/bin:$PATH"
site="$(echo "$root"/studio/skills/studio/kit/.venv/lib/python3*/site-packages)"
ok=() missing=()
have() { command -v "$1" >/dev/null; }

if [ "${CLAUDE_CODE_REMOTE:-}" = true ]; then where=cloud; else where="$(hostname -s)"; fi

have uv && ok+=("uv") || missing+=("uv: nothing runs | script/bootstrap")
if have nix; then
  ok+=("system tools from the Nix flake")
else
  for tool in ffmpeg sox; do have "$tool" && ok+=("$tool") || missing+=("$tool: studio renders and its tests | script/bootstrap"); done
  # The system's ffmpeg is not the flake's (apt's is a different major version), so renders may differ.
  have ffmpeg && missing+=("the flake's system tools: renders that match other machines' | install Nix")
  node_major="$(node --version 2>/dev/null | sed 's/^v\([0-9]*\).*/\1/')"
  [ "${node_major:-0}" -ge 22 ] && ok+=("node $node_major") || missing+=("node 22+: studio's engines and tests | install Node 22")
fi
[ -f "$site/soundfile.py" ] && ok+=("studio kit") || missing+=("studio kit: studio commands and tests | script/bootstrap")
[ -d "$site/kokoro" ] && ok+=("kokoro") || missing+=("kokoro: local narration | script/bootstrap --kokoro (needs huggingface.co)")
browsers=("$root"/studio/skills/studio/.cache/browser/*/*/*headless*)
if [ -e "${browsers[0]}" ] || [ -n "${STUDIO_BROWSER:-}" ] || [ -d "/Applications/Google Chrome.app" ] || have chromium || have google-chrome; then
  ok+=("browser")
else
  missing+=("headless browser: studio stills and renders | script/bootstrap --studio")
fi
have worklog && ok+=("worklog CLI") || missing+=("worklog CLI: the worklog skill | script/bootstrap")

skills=0
for s in "$root"/.claude/skills/*/SKILL.md; do [ -f "$s" ] && skills=$((skills + 1)); done
ok+=("$skills skills from the working tree")

# Only the cloud restricts hosts; Kokoro's weights are the download most likely to be blocked.
if [ "$where" = cloud ] && ! curl -sfI -m 4 -o /dev/null https://huggingface.co/; then
  missing+=("huggingface.co unreachable: Kokoro weights | add it to the environment's allowed hosts")
fi

# Only new ElevenLabs narration needs the key; videos whose audio/elevenlabs_cache/ is committed build
# without it. It comes committed and encrypted (script/secrets); this machine needs its age key. Checked
# by decrypting to nowhere: this line lands in every session's transcript, so never the value.
secrets="$root/secrets/secrets.json"
if [ -n "${ELEVENLABS_API_KEY:-}" ]; then
  ok+=("ElevenLabs key")
elif ! have sops; then
  missing+=("sops and age: new ElevenLabs narration | script/bootstrap")
elif [ ! -f "$secrets" ]; then
  missing+=("ElevenLabs key: new ElevenLabs narration only | on the Mac, script/secrets init mac, then script/secrets set ELEVENLABS_API_KEY")
elif sops decrypt --extract '["ELEVENLABS_API_KEY"]' "$secrets" >/dev/null 2>&1; then
  ok+=("ElevenLabs key (secrets)")
elif [ "$where" = cloud ]; then
  missing+=("ElevenLabs key: new ElevenLabs narration only | set SOPS_AGE_KEY in the environment's variables (script/secrets cloud on the Mac makes it), then start a new session")
else
  missing+=("ElevenLabs key: new ElevenLabs narration only | script/secrets init $where, commit, then script/secrets rekey on a machine that can decrypt")
fi
if [ "$where" = cloud ] && [ "$(curl -s -o /dev/null -m 4 -w '%{http_code}' https://api.elevenlabs.io/v1/models)" = 000 ]; then
  missing+=("api.elevenlabs.io unreachable: new ElevenLabs narration | add it to the environment's allowed hosts")
fi

line="papershop ready ($where): $(IFS=,; echo "${ok[*]}" | sed 's/,/, /g')"
if [ ${#missing[@]} -gt 0 ]; then
  line="$line. Not here: $(printf '%s\n' "${missing[@]}" | cut -d: -f1 | paste -sd, - | sed 's/,/, /g')"
fi
details="$(printf '%s\n' "${missing[@]+"${missing[@]}"}" | sed -n 's/^\(.*\): \(.*\) | \(.*\)$/- \1 (affects \2): \3/p')"

if [ "${1:-}" = --hook ]; then
  # The receipt lands in the transcript, so a past session says what it ran with.
  context="$line"$'\n'"$details"$'\n'"Bootstrap with script/bootstrap, test with script/test, check with script/doctor (see CLAUDE.md)."
  context="$context"$'\n'"Environment receipt (script/receipt):"$'\n'"$("$root/script/receipt")"
  python3 -c 'import json,sys; print(json.dumps({"systemMessage": sys.argv[1],
    "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": sys.argv[2]}}))' "$line" "$context"
else
  echo "$line"
  [ -z "$details" ] || echo "$details"
fi
