#!/usr/bin/env python3
"""Check that the repo's pins agree with each other and with the flake, which is their source: one
nixpkgs in both flake.locks, uv.toml's uv and .python-version's Python equal to nixpkgs' (when Nix is
here to ask), the studio kit on the same Python, exact versions in every PEP 723 script header, and
Kokoro's weights pinned to a commit. Prints one line per problem; exits 1 if there is any."""
import json
import re
import shutil
import subprocess
from pathlib import Path

root = Path(__file__).resolve().parents[1]
problems = []


def nixpkgs(lock):
    return json.loads((root / lock).read_text())["nodes"]["nixpkgs"]["locked"]["rev"]


if nixpkgs("flake.lock") != nixpkgs("studio/flake.lock"):
    problems.append("flake.lock and studio/flake.lock pin different nixpkgs")

uv_pin = re.search(r'^required-version = ">=(.+)"$', (root / "uv.toml").read_text(), re.M).group(1)
python_pin = (root / ".python-version").read_text().strip()
kit_python = (root / "studio/skills/studio/kit/.python-version").read_text().strip()
if kit_python != python_pin:
    problems.append(f"studio kit .python-version is {kit_python}, the repo's is {python_pin}")

if shutil.which("nix"):
    for attr, pin, where in (("uv", uv_pin, "uv.toml"), ("python312", python_pin, ".python-version")):
        found = subprocess.run(["nix", "--extra-experimental-features", "nix-command flakes", "eval", "--raw",
                                "--inputs-from", str(root), f"nixpkgs#{attr}.version"],
                               capture_output=True, text=True, check=True).stdout
        if found != pin:
            problems.append(f"{where} pins {pin}, the flake's nixpkgs has {attr} {found}")

for script in root.glob("**/*.py"):
    if ".venv" in script.parts or "node_modules" in script.parts:
        continue
    header = re.search(r"^# /// script\n(.*?)^# ///$", script.read_text(errors="ignore"), re.S | re.M)
    deps = re.search(r"dependencies = \[(.*?)\]", header.group(1), re.S) if header else None
    for dep in re.findall(r'"([^"]+)"', deps.group(1)) if deps else []:
        if "==" not in dep:
            problems.append(f"{script.relative_to(root)}: {dep} is not an exact version")

narration = (root / "studio/skills/studio/kit/src/studio_kit/narration.py").read_text()
if not re.search(r'^KOKORO_REVISION = "[0-9a-f]{40}"$', narration, re.M):
    problems.append("narration.py does not pin Kokoro's weights to a commit (KOKORO_REVISION)")

print("\n".join(problems) or f"pins agree: uv {uv_pin}, Python {python_pin}, nixpkgs {nixpkgs('flake.lock')[:12]}")
raise SystemExit(1 if problems else 0)
