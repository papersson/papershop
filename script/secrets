#!/usr/bin/env bash
# Keys papershop's tools need (the ElevenLabs key), committed encrypted with sops to one age recipient
# per machine. A machine needs only its own age key: a file on the Mac and z840, SOPS_AGE_KEY in a cloud
# environment's variables. Values never pass through argv, a log or this script's output.
#
#   script/secrets init NAME              # this machine: make its age key if missing, add it as NAME
#   script/secrets cloud                  # an age key for cloud environments: copied to the clipboard
#   script/secrets set KEY                # prompt for KEY's value (hidden) and store it encrypted
#   script/secrets list                   # names of the secrets and of the machines that can read them
#   script/secrets rekey                  # re-encrypt to secrets/recipients (after adding or removing one)
#   script/secrets remove-machine NAME    # drop NAME, re-encrypt; then rotate what NAME could read
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$root/.cache/tools/secrets/bin:$root/.cache/tools/bin:$PATH"
file="$root/secrets/secrets.json"
recipients="$root/secrets/recipients"
die() { echo "secrets: $*" >&2; exit 1; }
command -v sops >/dev/null && command -v age-keygen >/dev/null || die "sops and age are missing: run script/bootstrap"

# Where sops looks for this machine's age key when SOPS_AGE_KEY is not set.
keyfile() {
  if [ -n "${SOPS_AGE_KEY_FILE:-}" ]; then echo "$SOPS_AGE_KEY_FILE"
  elif [ -n "${XDG_CONFIG_HOME:-}" ]; then echo "$XDG_CONFIG_HOME/sops/age/keys.txt"
  elif [ "$(uname)" = Darwin ]; then echo "$HOME/Library/Application Support/sops/age/keys.txt"
  else echo "$HOME/.config/sops/age/keys.txt"; fi
}
recipient_list() { awk 'NF == 2 { print $2 }' "$recipients" 2>/dev/null | paste -sd, -; }
add_recipient() {  # NAME PUBLIC-KEY
  mkdir -p "$root/secrets"
  if grep -q " $2\$" "$recipients" 2>/dev/null; then return; fi
  grep -q "^$1 " "$recipients" 2>/dev/null && die "a machine named $1 is already listed; remove-machine it first"
  echo "$1 $2" >> "$recipients"
  echo "secrets: added $1 to secrets/recipients"
}
# Encrypt JSON on stdin to every recipient, replacing the file only when that succeeds.
encrypt() {
  local r; r="$(recipient_list)"; [ -n "$r" ] || die "no recipients yet: run script/secrets init NAME"
  sops encrypt --input-type json --output-type json --age "$r" --filename-override "$file" /dev/stdin > "$file.tmp"
  mv "$file.tmp" "$file"
}
current() { if [ -f "$file" ]; then sops decrypt "$file"; else echo '{}'; fi; }
rekey() {
  [ -f "$file" ] || return 0
  current | encrypt || die "this machine can't decrypt secrets/secrets.json; run rekey on one that can"
  echo "secrets: re-encrypted for $(awk 'NF == 2 { print $1 }' "$recipients" | paste -sd' ' -)"
}

case "${1:-}" in
  init)
    name="${2:?usage: script/secrets init NAME (mac, z840, ...)}"
    k="$(keyfile)"
    if [ -z "${SOPS_AGE_KEY:-}" ] && [ ! -f "$k" ]; then
      mkdir -p "$(dirname "$k")" && (umask 077 && age-keygen -o "$k" 2>/dev/null)
      echo "secrets: made this machine's age key at $k (back it up; never commit it)"
    fi
    pub="$(if [ -n "${SOPS_AGE_KEY:-}" ]; then age-keygen -y <<<"$SOPS_AGE_KEY"; else age-keygen -y "$k"; fi)"
    add_recipient "$name" "$pub"
    if [ -f "$file" ] && ! sops decrypt "$file" >/dev/null 2>&1; then
      echo "secrets: commit secrets/recipients, then run script/secrets rekey on a machine that can decrypt"
    else
      rekey
    fi ;;
  cloud)
    # One key for every cloud session. It is printed nowhere: the clipboard holds it until pasted.
    command -v pbcopy >/dev/null || die "cloud needs a Mac's clipboard (pbcopy) so the key is never printed"
    key="$(age-keygen 2>/dev/null | grep '^AGE-SECRET-KEY-')"
    add_recipient cloud "$(age-keygen -y <<<"$key")"
    printf '%s' "$key" | pbcopy; unset key
    rekey
    echo "secrets: the cloud's age key is on the clipboard. Paste it as the environment variable"
    echo "  SOPS_AGE_KEY in the cloud environment's settings, then commit secrets/ and push." ;;
  set)
    name="${2:?usage: script/secrets set KEY}"
    [[ "$name" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "KEY is an environment-style name, like ELEVENLABS_API_KEY"
    [ -t 0 ] || die "set reads the value from a terminal, so run it yourself rather than through an agent"
    read -rsp "value for $name (hidden): " value; echo
    [ -n "$value" ] || die "empty value; nothing changed"
    current | SECRET_NAME="$name" SECRET_VALUE="$value" python3 -c \
      'import json, os, sys; d = json.load(sys.stdin); d[os.environ["SECRET_NAME"]] = os.environ["SECRET_VALUE"]; json.dump(d, sys.stdout)' |
      encrypt
    unset value
    echo "secrets: stored $name; commit secrets/ and push" ;;
  list)
    # Names are plain text in a sops file; only values are encrypted, so this needs no key.
    [ -f "$file" ] && python3 -c 'import json, sys; print("\n".join(k for k in json.load(open(sys.argv[1])) if k != "sops"))' "$file"
    echo "machines: $(awk 'NF == 2 { print $1 }' "$recipients" 2>/dev/null | paste -sd' ' -)" ;;
  rekey) rekey ;;
  remove-machine)
    name="${2:?usage: script/secrets remove-machine NAME}"
    grep -q "^$name " "$recipients" 2>/dev/null || die "no machine named $name"
    grep -v "^$name " "$recipients" > "$recipients.tmp"; mv "$recipients.tmp" "$recipients"
    rekey
    echo "secrets: $name can't read new versions, but it had the old ones: rotate each secret (set it again)" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
